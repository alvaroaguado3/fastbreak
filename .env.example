# Copy to .env and fill in. Never commit .env.
# --- Sportradar (Realtime customer required for push feeds) ---
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial          # trial | production
SPORTRADAR_LOCALE=en

# --- X / Twitter API v2 (pay-per-use as of 2026; dry-run by default) ---
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Pipeline ---
FASTBREAK_PUBLISH_DRY_RUN=true         # true = log only, never hit the X API
FASTBREAK_GENERATOR=template           # template | neural
FASTBREAK_NEURAL_MODEL_PATH=checkpoints/headline-lora
FASTBREAK_SURPRISE_THRESHOLD=0.62      # min surprise score [0..1] to publish
FASTBREAK_PERCENTILE_THRESHOLD=0.90    # min percentile to flag a stat
